# FastAPI OTP Email (Gmail SMTP)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional salt for hashing OTP in memory
OTP_SECRET=change-me

# User DB (JSON) path used to verify email exists (optional in production)
USER_DB_PATH=../../BNU-Student-Portal/Data/db.json

# Primary database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# AI provider key
GROQ_API_KEY=your-groq-api-key

# Backend server
API_HOST=0.0.0.0
API_PORT=8000

# HTTPS local dev certs (usually leave empty on cloud platforms)
SSL_KEYFILE=
SSL_CERTFILE=

# Password policy
PASSWORD_MAX_AGE_DAYS=100
PASSWORD_HISTORY_LIMIT=2
