# =========================
# Backend Core
# =========================
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Optional JSON user source (legacy/fallback)
USER_DB_PATH=../../BNU-Student-Portal/Data/db.json

# =========================
# Security / Auth
# =========================
# سر إضافي يدخل في توليد/تحقق OTP (لازم يكون قوي وعشوائي)
OTP_SECRET=change-me
# بعد كم يوم كلمة المرور تعتبر منتهية ويطلب تغييرها
PASSWORD_MAX_AGE_DAYS=100
# منع إعادة استخدام آخر N كلمات مرور
PASSWORD_HISTORY_LIMIT=2

# Session security
# خروج تلقائي بعد خمول المستخدم (بالدقائق)
SESSION_IDLE_TIMEOUT_MINUTES=15
# أقصى مدة للجلسة حتى مع النشاط (بالساعات)
SESSION_ABSOLUTE_TIMEOUT_HOURS=1
# أقصى عدد جلسات/أجهزة مفتوحة لنفس الحساب
MAX_ACTIVE_SESSIONS_PER_USER=2
# كل كام ثانية نحدّث آخر نشاط للجلسة في قاعدة البيانات
SESSION_TOUCH_INTERVAL_SECONDS=45

# Login brute-force protection
# عدد محاولات تسجيل الدخول المسموح بها قبل الحظر
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# نافذة احتساب المحاولات (بالدقائق)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=1
# مدة الحظر المؤقت بعد تجاوز المحاولات (بالدقائق)
LOGIN_LOCKOUT_MINUTES=1

# =========================
# Integrations
# =========================
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=verified-sender@yourdomain.com
GROQ_API_KEY=your-groq-api-key

# =========================
# Local HTTPS (mkcert)
# =========================
SSL_KEYFILE=
SSL_CERTFILE=
