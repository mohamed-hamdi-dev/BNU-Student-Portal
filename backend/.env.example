# FastAPI OTP Email (Gmail SMTP)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Optional salt for hashing OTP in memory
OTP_SECRET=change-me

# User DB (JSON) path used to verify email exists
# Default in code: ../../BNU-Student-Portal/Data/db.json
USER_DB_PATH=../../BNU-Student-Portal/Data/db.json

# Database connection string
# Local SQLite:
DATABASE_URL=sqlite:///./bnu_portal.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Password policy
PASSWORD_MAX_AGE_DAYS=100
PASSWORD_HISTORY_LIMIT=2
